{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "oilgate-pepper",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "routes": [{ "pattern": "pepper.oilgateai.com", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "PEPPER_LIMIT", "namespace_id": "728474", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "GEMINI_MODEL": "gemini-2.5-flash", "HOME_LAB_ENABLED": "false", "ALLOWED_ORIGINS": "https://oilgaterealty.github.io,https://oilgaterealty.com,https://www.oilgaterealty.com" },
  "observability": { "enabled": false }
}
